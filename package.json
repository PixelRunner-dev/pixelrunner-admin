{
  "name": "pixelrunner-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "config": {
    "project_name": "admin-vue",
    "remote_user": "root",
    "remote_pass": "pixelrunner",
    "remote_host": "192.168.5.178",
    "remote_dir": "/home/pixelrunner/pixelrunner26/admin-vue"
  },
  "scripts": {
    "dev": "DEV=true vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "-preview:a11y": "DEV=true vite preview -l error --port 4166 --strictPort",
    "audit": "npm audit --audit-level high",
    "outdated": "npm outdated",
    "-a11y": "run-p -r -s preview:a11y a11y:axe",
    "-a11y:axe": "npx axe --chrome-path \"$(npx playwright install --list | grep 'chromium' | grep -v 'headless' | xargs)/chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing\" -t best-practice http://localhost:4166",
    "-a11y:axe2": "axe -t best-practice http://localhost:4166",
    "benchmark": "vitest bench --ui",
    "test": "run-p test:unit test:e2e",
    "test:unit": "vitest run --coverage",
    "test:unit:ci": "vitest run --coverage --no-color --reporter dot",
    "test:unit:watch": "vitest watch --coverage --ui",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --quiet --reporter dot",
    "test:e2e:watch": "playwright test --ui",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-p lint:syntax lint:js",
    "lint:syntax": "prettier --check .",
    "lint:js": "eslint . --cache",
    "lint:js:ci": "eslint . --env-info",
    "format": "run-p format:syntax format:js",
    "format:syntax": "prettier --write --experimental-cli .",
    "format:js": "eslint . --fix",
    "ci": "DEBUG_COLORS=false run-p -s audit type-check lint:syntax lint:js:ci test:unit:ci test:e2e:ci",
    "update-geo": "node scripts/update-geo-db.mjs",
    "remote:npm-install": "npx remote-npm install",
    "remote:push": "npx remote-push"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "crypto-js": "^4.2.0",
    "fuse.js": "^7.4.1",
    "i18next": "^26.3.1",
    "i18next-vue": "^5.4.0",
    "js-sha1": "^0.7.0",
    "js-sha256": "^0.11.1",
    "pixelrunner-shared": "github:PixelRunner-dev/pixelrunner-shared",
    "trystero": "^0.25.1",
    "vue": "^3.5.35",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.1.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/crypto-js": "^4.2.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/eslint-plugin": "^1.6.4",
    "@vitest/ui": "^4.0.16",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "daisyui": "^5.5.20",
    "eslint": "^10.4.1",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-vue": "~10.9.1",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  },
  "optionalDependencies": {
    "bufferutil": "*"
  }
}
